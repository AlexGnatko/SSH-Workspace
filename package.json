{
  "name": "ssh-workspace",
  "version": "0.2.6",
  "private": true,
  "description": "Desktop SSH and SFTP client with local connection profiles",
  "author": "Alex Gnatko",
  "homepage": "https://ssh-workspace.ag38.xyz/",
  "desktopName": "org.sshworkspace.desktop",
  "license": "MIT",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc && node scripts/build.cjs",
    "start": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win --dir --publish never",
    "package:msi": "npm run build && electron-builder --win msi --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ssh2": "1.15.6",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.0"
  }
}
